# ──────────────────────────────────────────────────────────────────────────────
# HIREIQ - STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env on your staging server and populate with staging credentials.
# IMPORTANT: Generate distinct keys and use test-mode credentials for staging.
# Do NOT reuse production credentials.

# ─── SUPABASE CONFIGURATION (STAGING DATABASE)
# Must point to your dedicated Staging Supabase project, NOT production.
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_SERVICE_KEY=your-staging-service-role-key-here

# ─── GEMINI API CONFIGURATION
GEMINI_API_KEY=your-gemini-api-key-here

# ─── SECURITY & ENCRYPTION
# JWT_SECRET_KEY: Generate a unique, cryptographically secure random string.
JWT_SECRET_KEY=generate-a-new-distinct-long-random-string-for-staging
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# FIELD_ENCRYPTION_KEY: Generate a new 32-byte urlsafe base64 Fernet key.
# Run this command to generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MUST be different from production to ensure environment isolation.
FIELD_ENCRYPTION_KEY=generate-a-new-distinct-32-byte-base64-fernet-key-for-staging

# ─── STRIPE INTEGRATION (MUST USE TEST MODE)
# Use your Stripe test mode keys (starting with sk_test_). Never use live keys (sk_live_).
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key
# Stripe test webhook signing secret (starts with whsec_) pointing to staging server
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_test_webhook_secret
STRIPE_PRICE_PRO_ID=price_staging_pro_xxx
STRIPE_PRICE_BUSINESS_ID=price_staging_business_xxx
STRIPE_PRICE_ENTERPRISE_ID=price_staging_enterprise_xxx

# ─── FRONTEND & EMAIL
FRONTEND_URL=https://staging.hireiq.com
RESEND_API_KEY=re_your_staging_resend_api_key
FROM_EMAIL=HireIQ Staging <onboarding@resend.dev>

# ─── MONITORING & ANALYTICS
posthog_project_api_key=your_staging_posthog_key
POSTHOG_API_KEY=your_staging_posthog_key
POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=your_staging_sentry_dsn

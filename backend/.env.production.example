# ==============================================================================
# HIREIQ PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env on your production server and fill in the values.
# NEVER commit the actual .env file containing real secrets to Git.

# ─── System / General ─────────────────────────────────────────────────────────
# Environment stage: production
NODE_ENV=production
PYTHONUNBUFFERED=1

# Cryptographically secure random 64-char string (used for signing JWT tokens)
JWT_SECRET_KEY=change_me_to_a_secure_64_character_hex_string_in_production

# CORS allowed frontend origins (comma-separated list, e.g., your domains)
CORS_ORIGINS=https://hireiq.app,https://www.hireiq.app

# API Rate limits per minute
RATE_LIMIT_PER_MINUTE=100

# ─── Database & Broker ────────────────────────────────────────────────────────
# PostgreSQL Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:your_secure_postgres_password_here@db:5432/hireiq

# Redis Broker URL (used by Celery and Redis caching)
# Format: redis://[host]:[port]/[db_index]
REDIS_URL=redis://redis:6379/0

# ─── GDPR & PII Security ──────────────────────────────────────────────────────
# Symmetric Fernet Encryption Key for candidate PII columns (name, email)
# MUST remain static. Generate using:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=your_static_32_byte_fernet_key_here

# ─── Third-Party Services ─────────────────────────────────────────────────────
# Google Gemini API Key for parsing resumes and calculating blind ratings
GEMINI_API_KEY=AIzaSyYourProductionGeminiAPIKeyHere

# Stripe Payments & Billing
STRIPE_SECRET_KEY=sk_live_YourStripeSecretKeyHere
STRIPE_WEBHOOK_SECRET=whsec_YourStripeWebhookSigningSecretHere

# Stripe Plan Price IDs (from Stripe dashboard products page)
STRIPE_PRICE_PRO_ID=price_1MockProPriceID
STRIPE_PRICE_BUSINESS_ID=price_1MockBusinessPriceID
STRIPE_PRICE_ENTERPRISE_ID=price_1MockEnterprisePriceID

# Resend Transactional Email API Key
RESEND_API_KEY=re_YourResendAPIKeyHere
FROM_EMAIL=HireIQ Onboarding <onboarding@hireiq.app>

# ─── Monitoring & Reliability ─────────────────────────────────────────────────
# Sentry DSN for error reporting
SENTRY_DSN=https://your_sentry_public_key@o0.ingest.sentry.io/your_sentry_project_id

# PostHog Project API Key and Host for user metrics
POSTHOG_API_KEY=phc_YourPostHogAPIKeyHere
POSTHOG_HOST=https://app.posthog.com

# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to version control.

# Supabase — get from https://supabase.com/dashboard/project/<your-project>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# Google Gemini — get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-64-char-random-string

# GitHub API (optional — raises rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=your_github_personal_access_token

# Stripe Settings
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PRICE_PRO=your_stripe_price_pro_here
STRIPE_PRICE_BUSINESS=your_stripe_price_business_here
STRIPE_PRICE_ENTERPRISE=your_stripe_price_enterprise_here


# Database
DATABASE_URL=sqlite:///./hireiq.db

# Security & Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here
FIELD_ENCRYPTION_KEY=your_32_byte_base64_encryption_key_here

# Redis (for background workers)
REDIS_URL=redis://localhost:6379/0

# GitHub Integration
GITHUB_TOKEN=your_github_personal_access_token_here

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_ID=price_...
STRIPE_PRICE_BUSINESS_ID=price_...
STRIPE_PRICE_ENTERPRISE_ID=price_...

# Email (Resend)
RESEND_API_KEY=re_...
FROM_EMAIL=HireIQ <onboarding@resend.dev>

# Sentry (Optional Error Monitoring)
SENTRY_DSN=

# PostHog (Optional Product Analytics)
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# CORS Configuration
CORS_ORIGINS=http://localhost:6901,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
